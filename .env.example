# Copy to `.env` at the repo root for docker compose and local backend.
# Never commit real secrets.

# --- Core ---
ENVIRONMENT=production
# DEBUG=false

# PostgreSQL (docker compose `postgres` service)
POSTGRES_USER=liman
POSTGRES_PASSWORD=change-me-use-long-random-password
POSTGRES_DB=liman_salon

# SQLAlchemy URL (override when using external Postgres)
# DATABASE_URL=postgresql+psycopg://liman:change-me@postgres:5432/liman_salon

# Auth & booking tokens (min 32 chars in production; do not use dev defaults)
JWT_SECRET_KEY=change-me-use-at-least-32-random-characters-here
BOOKING_MANAGE_TOKEN_PEPPER=change-me-use-at-least-32-random-pepper-here

# Media (local disk; api container mounts a volume at /data/media)
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_ROOT=/data/media

# Public web entrypoint (host port mapped to nginx)
WEB_PORT=8080

# First-salon bootstrap (production/staging only; see docs/ops/)
# ALLOW_FIRST_SALON_BOOTSTRAP=1
